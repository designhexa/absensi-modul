# === Supabase Configuration ===
# Get these values from: Supabase Dashboard → Project Settings → API

# Public anon key (safe for client-side)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Service Role Key (for running migrations only — KEEP SECRET!)
# This has admin privileges. Never expose to client-side code.
# Ambil dari: Supabase Dashboard → Project Settings → API → service_role key
VITE_SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
